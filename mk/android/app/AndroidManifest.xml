<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.construo.game"
    android:versionCode="1"
    android:versionName="0.2.3-dev">

    <uses-sdk android:minSdkVersion="22" android:targetSdkVersion="34" />

    <uses-feature android:glEsVersion="0x00020000" android:required="true" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <application
        android:label="Construo"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:hasCode="true">
        <activity
            android:name="org.libsdl.app.SDLActivity"
            android:label="Construo"
            android:theme="@android:style/Theme.NoTitleBar.Fullscreen"
            android:configChanges="orientation|keyboardHidden|screenSize|screenLayout|uiMode"
            android:screenOrientation="landscape"
            android:launchMode="singleTask"
            android:alwaysRetainTaskState="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
